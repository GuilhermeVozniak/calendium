# ── Better Auth (identity provider — hosted by this Next.js app at /api/auth/*) ─
# All read at RUNTIME (server-side), never inlined into the browser bundle.

# Secret used to sign sessions and encrypt the jwks private keys.
# Generate: openssl rand -base64 32   (must be >= 32 chars, stable across deploys)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Public web origin (no trailing slash). REQUIRED — OAuth callbacks break without it.
BETTER_AUTH_URL=http://localhost:3000

# Postgres shared with the Go API. Better Auth owns the user/session/account/
# verification/jwks tables (created by backend/migrations/0002_better_auth.sql).
DATABASE_URL=postgres://calendium:calendium@localhost:5432/calendium

# Social login (optional — a provider is only enabled when both vars are set).
# Google is shared between login and mailbox-connect: register both redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: APPLE_CLIENT_ID is the Services ID; APPLE_CLIENT_SECRET is the ES256
# client-secret JWT generated from your .p8 key (max 6-month expiry, regenerate).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Calendium Go API ──────────────────────────────────────────────────────────
# Base URL (no trailing slash). Unset = same origin as the web app.
NEXT_PUBLIC_API_URL=http://localhost:8080
