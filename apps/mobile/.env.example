# Supabase + API URL are OPTIONAL dev seeds. At runtime the app discovers them
# from the server you connect to on the "Connect to your server" screen
# (lib/server-config), so a single build can point at any Calendium instance.
# When set, they pre-fill the Connect screen / seed the default clients.
EXPO_PUBLIC_SUPABASE_URL=https://qkghnmmxbibtxltdrehg.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_UpNr_T4RLLfibrL8nAoi_g_v9mRAALG

# REQUIRED for OAuth deep linking (see docs/auth-supabase-deep-linking.md).
EXPO_PUBLIC_SCHEME=calendium://
EXPO_PUBLIC_AUTH_REDIRECT_MODE='proxy'

# Calendium API (backend/) base URL — optional dev seed / Connect-screen default.
EXPO_PUBLIC_API_URL=http://localhost:8080