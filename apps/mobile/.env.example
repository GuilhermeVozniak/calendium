# Calendium API (backend/) base URL — optional dev seed / Connect-screen default.
# At runtime the app discovers the server (and its Better Auth base URL) from the
# server you connect to on the "Connect to your server" screen: it fetches
# /v1/instance, which returns `authBaseUrl` + `authProviders` (lib/server-config).
# A single build can therefore point at any Calendium instance.
EXPO_PUBLIC_API_URL=http://localhost:8080

# NOTE: Auth is Better Auth (hosted by the web app at ${origin}/api/auth) and is
# discovered via /v1/instance — there is no auth env var here. The deep-link
# scheme ("calendium") is set in app.json and lib/auth-client.ts.
