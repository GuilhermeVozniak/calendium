# The desktop app discovers everything about a server — including its Better
# Auth base URL and enabled sign-in providers — from that server's public
# /v1/instance descriptor on the Connect screen (src/lib/server-config), so a
# single build can point at any Calendium instance. Identity is Better Auth,
# hosted by the web app at ${server}/api/auth; there are no auth secrets here.
#
# VITE_API_URL is an OPTIONAL dev convenience: it only pre-fills the server URL
# field on the Connect screen. You still connect (and then sign in) there.

# Calendium Go API base URL (no trailing slash).
VITE_API_URL=http://localhost:8080
