# All three vars below are OPTIONAL dev seeds. At runtime the desktop app
# discovers Supabase creds + the API URL from the server you connect to on the
# Connect screen (src/lib/server-config), so a single build can point at any
# Calendium instance. When VITE_API_URL + both Supabase vars are set, they seed
# a default "connected" server so local dev skips the Connect screen.

# Supabase project (identity provider — Google / Apple OAuth, email)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Calendium Go API base URL (no trailing slash).
VITE_API_URL=http://localhost:8080
