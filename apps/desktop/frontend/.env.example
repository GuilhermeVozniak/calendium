# Supabase project (identity provider — Google / Apple OAuth, email)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Calendium Go API base URL (no trailing slash).
# Leave unset to run the desktop app on bundled mock data (see src/lib/api.ts).
VITE_API_URL=http://localhost:8080
