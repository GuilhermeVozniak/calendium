###############################################################################
# Calendium — self-hosting environment (docker compose)
#
#   1. Copy to .env:            cp .env.example .env
#   2. Generate a token key:    make gen-secret     (or: openssl rand -hex 32)
#   3. Fill in Auth + (optional) provider creds, then:  make self-host-up
#
# Every container reads what it needs from this single file. Values marked
# "(cloud only)" are for our managed hosting and stay blank when self-hosting.
###############################################################################

# ─── Postgres (bundled `db` service) ─────────────────────────────────────────
POSTGRES_USER=calendium
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=calendium
# Connection string used by api + worker. Host is the compose service name `db`.
# Keep the user/password/db in sync with POSTGRES_* above.
DATABASE_URL=postgres://calendium:change-me-please@db:5432/calendium?sslmode=disable

# ─── Instance identity & mode ────────────────────────────────────────────────
# Self-hosted mode: disables billing/entitlement gating (all features unlocked)
# and makes the billing endpoints return "billing disabled on self-hosted".
SELF_HOSTED=true
# Shown to clients on the connect screen and via GET /v1/instance.
INSTANCE_NAME=Calendium
# Public web origin, for building absolute links (no trailing slash).
APP_URL=http://localhost:3000
# Public web origin advertised to clients (authBaseUrl in GET /v1/instance).
# When both are set PUBLIC_WEB_URL WINS over APP_URL; blank falls back to APP_URL.
PUBLIC_WEB_URL=http://localhost:3000
# Domain the reverse proxy serves (automatic HTTPS via Caddy / certbot).
DOMAIN=localhost
# Email Let's Encrypt uses for expiry notices (Caddy profile).
ACME_EMAIL=

# ─── Secrets at rest ─────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM provider-token encryption. REQUIRED.
# Generate: openssl rand -hex 32   (or: make gen-secret)
TOKEN_ENCRYPTION_KEY=

# ─── Auth (Better Auth) — hosted by the web app at ${BETTER_AUTH_URL}/api/auth ─
# Better Auth is the identity provider for web, desktop, and mobile. It runs
# inside the Next.js web app, uses this same Postgres (DATABASE_URL), and issues
# EdDSA (Ed25519) JWTs the Go backend verifies via JWKS. No Supabase.
# Signing/encryption secret for Better Auth. REQUIRED.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public web origin where Better Auth is reachable (= your DOMAIN as an https
# URL), no trailing slash. Dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Backend resource-server verification. The api + worker fetch Better Auth's
# public keys from AUTH_JWKS_URL *server-to-server*, so it must be reachable from
# inside the compose network — BETTER_AUTH_URL (a public origin) usually is not.
# Leave AUTH_JWKS_URL blank: docker-compose.yml defaults it to the in-network web
# service (http://web:3000/api/auth/jwks) so the stack works out of the box. Set
# it only to override, and only to a URL the api container can actually reach.
# AUTH_ISSUER is the expected token `iss`; blank derives it from BETTER_AUTH_URL.
AUTH_JWKS_URL=
AUTH_ISSUER=

# ─── Web app (Next.js) ───────────────────────────────────────────────────────
# Where the browser reaches the API. Behind the bundled proxy this is your
# domain (https://your-domain); direct/dev is http://localhost:8080.
# Leave blank for same-origin (recommended behind the Caddy proxy).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Cross-origin requests (CORS) & trusted origins ──────────────────────────
# The Go API and the Better Auth routes always allow the desktop app's WebView
# origins (wails://wails, wails://wails.localhost, http(s)://wails.localhost)
# plus BETTER_AUTH_URL and PUBLIC_WEB_URL. Add extra browser origins here
# (comma-separated) — e.g. a web app served from a different origin than the API.
CORS_ALLOWED_ORIGINS=
# Also trust http://localhost:* and http://127.0.0.1:* origins. Leave blank
# (false) in production — setting it logs a startup warning there. `bun run dev`
# trusts them regardless.
ALLOW_DEV_ORIGINS=

# ─── Provider OAuth apps (optional — connect Gmail/Calendar, Microsoft) ──────
# Public origin of THIS Go API, used as the base for the mailbox-connect OAuth
# callback: register ${PUBLIC_API_URL}/v1/accounts/callback/{google|microsoft}
# as the redirect URI in the Google/Microsoft consoles. Blank derives it from the
# incoming connect request (honoring X-Forwarded-Proto/Host) — correct behind the
# bundled Caddy proxy where the API shares your domain under /v1.
PUBLIC_API_URL=
# Extra allowed OAuth redirect targets (comma-separated), appended to the
# built-in localhost + calendium:// defaults. This is the client return URL the
# browser lands on *after* the callback completes — not the provider redirect URI.
OAUTH_ALLOWED_REDIRECT_URIS=
# Google OAuth — used for BOTH Better Auth login AND Gmail/Calendar connect.
# Register both redirect URIs on the same client:
#   ${BETTER_AUTH_URL}/api/auth/callback/google  (login)
#   your provider-connect callback                (mailbox connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple OAuth — Better Auth "Sign in with Apple" login.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ─── OpenRouter AI (optional — powers the AI suite: compose/ask/instant
# replies/auto drafts/auto labels/voice learning/event proposals) ────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Per-user daily AI call budget shared by interactive endpoints and
# background ai_jobs; rearms at the next UTC midnight (default 300).
AI_DAILY_LIMIT=300

# ─── Push notifications (optional) ───────────────────────────────────────────
# APNs (iOS/macOS) — HTTP/2 + ES256 JWT.
APNS_KEY_ID=
APNS_TEAM_ID=
# PEM contents of the .p8 key (newlines escaped as \n), not a file path.
APNS_KEY_P8=
# APNs topic = your iOS/macOS app's bundle id (default app.calendium). Set this
# to match the bundle id of the app build you distribute, or APNs rejects pushes.
APNS_TOPIC=
# FCM v1 (Android) — service-account JSON on a single line.
FCM_SERVICE_ACCOUNT_JSON=
# Web Push (VAPID).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Mail behavior ───────────────────────────────────────────────────────────
# Undo-send grace window in seconds for "send now" (default 15).
UNDO_SEND_SECONDS=15

# ─── Transactional email (SMTP) ──────────────────────────────────────────────
# One sender for the whole instance: the web app sends email-verification and
# password-reset mail, the api sends team invitations when the inviter has no
# connected mailbox. Any SMTP provider works (SES, Postmark, Resend, Mailgun,
# your own relay). See docs/self-hosting/providers.md §1d.
#   SELF_HOSTED=true  : optional. Blank SMTP_HOST = email off: sign-up needs no
#                       verification, "Forgot password?" tells users to ask the
#                       admin (docs/self-hosting/security.md), and team
#                       invitations return a link to share by hand.
#   SELF_HOSTED=false : SMTP_HOST and SMTP_FROM are REQUIRED; api, worker and
#                       web refuse to start without them.
# Setting SMTP_HOST turns email verification ON for email+password sign-up;
# existing accounts verify once, on their next sign-in.
SMTP_HOST=
SMTP_PORT=587
# Optional login; set both or neither.
SMTP_USER=
SMTP_PASS=
# "addr" or "Name <addr>", e.g. Calendium <no-reply@mail.example.com>
SMTP_FROM=
# true = implicit TLS (usually port 465); false = STARTTLS, which is mandatory
# unless SMTP_HOST is loopback (127.0.0.1 / localhost — Mailpit, a local relay).
SMTP_SECURE=false

# ─── Client IP for sign-in rate limits (web) ─────────────────────────────────
# Sign-in, sign-up and password reset are rate limited per client IP, with the
# counters in Postgres. true = the client is the FIRST X-Forwarded-For hop:
# only correct behind a proxy that OVERWRITES that header (the bundled Caddy
# profile does; nginx: proxy_set_header X-Forwarded-For $remote_addr).
# Blank/false = X-Forwarded-For is used only when single-valued; production
# logs a startup warning. Keep it false when browsers reach web:3000 directly.
TRUST_PROXY=

# ─── Paddle billing (cloud only — leave blank when self-hosting) ─────────────
# With SELF_HOSTED=false the api AND worker refuse to start unless the three
# keys are set. See docs/paddle-go-live.md.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_ANNUAL=
# Worker reconciliation cadence (Go duration).
BILLING_RECONCILE_INTERVAL=6h
# Web app (build-time, public): Paddle.js client token and environment.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ─── Host port mappings — override if 3000/8080 clash locally ────────────────
WEB_PORT=3000
API_PORT=8080
