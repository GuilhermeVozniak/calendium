# Calendium backend environment (docs/architecture.md "Environment").
# Copy to .env and fill in; only DATABASE_URL and TOKEN_ENCRYPTION_KEY are
# required to boot, the rest unlock their respective adapters.

# --- Deployment mode (open-core: self-hosted vs. cloud) ---
# SELF_HOSTED=true unlocks all features (entitlement gating becomes a no-op)
# and disables Stripe: the billing endpoints return 501 "billing is disabled on
# self-hosted instances". Leave false (default) for the managed $50/yr cloud.
SELF_HOSTED=false
# Shown to clients via GET /v1/instance (default "Calendium").
INSTANCE_NAME=Calendium
# Public web origin, used to build absolute links (no trailing slash). Optional.
# PUBLIC_WEB_URL is what clients see (authBaseUrl in GET /v1/instance): when both
# are set PUBLIC_WEB_URL WINS; blank PUBLIC_WEB_URL falls back to APP_URL.
APP_URL=
PUBLIC_WEB_URL=

# --- Core ---
DATABASE_URL=postgres://calendium:calendium@localhost:5432/calendium?sslmode=disable
# 32-byte hex key for AES-256-GCM provider-token encryption.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Listen address (or set PORT).
HTTP_ADDR=:8080

# --- Better Auth (identity provider hosted by the Next.js web app) ---
# Better Auth runs at ${BETTER_AUTH_URL}/api/auth/* and mints EdDSA JWTs; this
# Go backend is a pure resource server that verifies them via the JWKS endpoint.
# Public web origin, no trailing slash. Example: https://app.calendium.com
BETTER_AUTH_URL=
# JWKS endpoint and expected token issuer. Both are DERIVED from BETTER_AUTH_URL
# when left blank (${BETTER_AUTH_URL}/api/auth/jwks and ${BETTER_AUTH_URL});
# set them only to override.
AUTH_JWKS_URL=
AUTH_ISSUER=

# --- Provider OAuth apps (offline access for mail + calendar) ---
# Public origin of this API, used as the base for the mailbox-connect OAuth
# callback: register ${PUBLIC_API_URL}/v1/accounts/callback/{google|microsoft}
# as the redirect URI at Google/Microsoft. Blank derives it from the incoming
# connect request (honoring X-Forwarded-Proto/Host).
PUBLIC_API_URL=
# Extra allowed OAuth redirect targets (comma-separated), appended to the
# built-in localhost + calendium:// defaults. This is the client return URL the
# browser lands on *after* the callback completes, e.g. https://app.calendium.com
OAUTH_ALLOWED_REDIRECT_URIS=
# Extra browser origins allowed for CORS on the API + Better Auth routes
# (comma-separated). localhost dev + the desktop wails:// origin are allowed by
# default.
CORS_ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Sign in with Apple (Services ID + generated client secret). Reported in
# GET /v1/instance so clients show the Apple button; the login itself is
# handled by Better Auth in the web app.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Stripe ($50/yr annual plan, docs/payments.md) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ANNUAL=

# --- OpenRouter AI ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# --- Push: APNs (HTTP/2 + ES256 JWT) ---
APNS_KEY_ID=
APNS_TEAM_ID=
# PEM contents of the .p8 key (newlines escaped as \n), not a file path.
APNS_KEY_P8=
# APNs topic = your app's bundle id (default app.calendium). Set to match the
# bundle id of the iOS/macOS build you distribute, or APNs rejects pushes.
APNS_TOPIC=

# --- Push: FCM v1 (service-account JSON, single line) ---
FCM_SERVICE_ACCOUNT_JSON=

# --- Push: Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Mail behavior ---
# Undo-send grace in seconds for "send now" (default 15).
UNDO_SEND_SECONDS=15
